# ------------------------------------------------------------------------------
# NeoM server environment template
# Copy to `.env` and fill in real values. NEVER commit the filled file.
# ------------------------------------------------------------------------------

NODE_ENV=production
PORT=3300
HOST=127.0.0.1

# --- MySQL ---
# Panel server: 127.0.0.1      Dev machine: tx.zhengl.vip
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neom
DB_USER=NeoM
DB_PASSWORD=
DB_POOL=10

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES=7d
# 32-byte hex key used to AES-256-GCM encrypt API keys / OSS secrets at rest
SECRETS_KEY=

# --- Public ---
PUBLIC_BASE_URL=https://m.zhengl.vip
WEB_ROOT=/www/wwwroot/m.zhengl.vip/web/dist
CORS_ORIGINS=https://m.zhengl.vip,http://localhost:5273

# --- Aliyun OSS (private bucket, backend-signed access) ---
OSS_BUCKET=zhengle
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_REGION=oss-cn-guangzhou
OSS_DOMAIN=https://mdadmin.zhengl.vip
OSS_AK=
OSS_SK=
OSS_PREFIX_ADMIN=md/mdadmin
OSS_PREFIX_USER=md/user

# --- Xiaomi MiMo official AI (server-side only) ---
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# --- Runtime ---
REQ_LOG=1
UPLOAD_MAX_MB=50
